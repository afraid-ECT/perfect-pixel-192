{
  "manifest_version": 3,
  "name": "Perfect Pixel 192",
  "version": "1.0.0",
  "description": "把 AI 像素图 / 缩略图标还原成真正的完美像素：自动识别格宽、支持 192px 小图与 2px 细格，输出无插值的纯色像素图。",
  "action": {
    "default_title": "Perfect Pixel 192",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus"],
  "host_permissions": ["<all_urls>"]
}
